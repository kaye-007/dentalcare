{
  "name": "dentalcare",
  "version": "0.1.0",
  "private": true,
  "description": "DentalCare by NODE X \u2014 multi-tenant clinic management SaaS",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "api:dev": "npm run start:dev -w @dentalcare/api",
    "api:build": "npm run build -w @dentalcare/api",
    "api:start": "npm run start -w @dentalcare/api",
    "migrate:up": "npm run migrate:up -w @dentalcare/api",
    "migrate:down": "npm run migrate:down -w @dentalcare/api",
    "migrate:reset": "npm run migrate:reset -w @dentalcare/api",
    "migrate:create": "npm run migrate:create -w @dentalcare/api",
    "web:dev": "npm run dev -w @dentalcare/tenant-web",
    "web:build": "npm run build -w @dentalcare/tenant-web",
    "admin:dev": "npm run dev -w @dentalcare/admin-web",
    "admin:build": "npm run build -w @dentalcare/admin-web",
    "dev:setup": "node scripts/dev-setup.js",
    "dev:reset": "node scripts/dev-setup.js --reset",
    "smoke": "node scripts/smoke-api.js",
    "diagnose:login": "node scripts/diagnose-login.js"
  },
  "engines": {
    "node": ">=20"
  }
}
