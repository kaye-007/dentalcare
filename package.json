{
  "name": "dentalcare",
  "version": "0.1.0",
  "private": true,
  "description": "DentalCare by NODE X — multi-tenant clinic management SaaS",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run start:dev -w @dentalcare/api",
    "api:build": "npm run build -w @dentalcare/api",
    "api:start": "npm run start -w @dentalcare/api",
    "migrate:up": "npm run migrate:up -w @dentalcare/api",
    "migrate:down": "npm run migrate:down -w @dentalcare/api",
    "migrate:reset": "npm run migrate:reset -w @dentalcare/api",
    "migrate:create": "npm run migrate:create -w @dentalcare/api",
    "migrate:baseline": "node scripts/build-baseline.js",
    "web:dev": "npm run dev -w @dentalcare/tenant-web",
    "web:build": "npm run build -w @dentalcare/tenant-web",
    "admin:dev": "npm run dev -w @dentalcare/admin-web",
    "admin:build": "npm run build -w @dentalcare/admin-web",
    "build": "npm run shared:build && npm run api:build && npm run web:build && npm run admin:build",
    "typecheck": "npm run shared:build && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "node scripts/format-check.js",
    "test": "npm run test -w @dentalcare/api",
    "test:integration": "npm run test:integration -w @dentalcare/api",
    "audit:classes": "node scripts/audit-classes.js",
    "cf:deploy": "npm run cf:deploy -w @dentalcare/api && npm run cf:deploy -w @dentalcare/tenant-web && npm run cf:deploy -w @dentalcare/admin-web",
    "cf:dry-run": "npm run cf:dry-run -w @dentalcare/api && npm run cf:dry-run -w @dentalcare/tenant-web && npm run cf:dry-run -w @dentalcare/admin-web",
    "dev:up": "docker compose -f infra/docker/docker-compose.yml --project-directory . up -d --build",
    "dev:down": "docker compose -f infra/docker/docker-compose.yml --project-directory . down",
    "dev:reset": "docker compose -f infra/docker/docker-compose.yml --project-directory . down -v && docker compose -f infra/docker/docker-compose.yml --project-directory . up -d --build",
    "dev:setup": "node scripts/dev-setup.js",
    "dev:setup:reset": "node scripts/dev-setup.js --reset",
    "smoke": "node scripts/smoke-api.js",
    "doctor": "node scripts/doctor.js",
    "admin:create": "npm run bootstrap-admin -w @dentalcare/api",
    "shared:build": "npm run build -w @dentalcare/shared"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.4"
  }
}
