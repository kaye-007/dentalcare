# ─────────────────────────────────────────────────────────────
# Production environment for the DentalCare API.
#
# Copy into your host's secret manager (Render/Railway env vars, or a
# root-owned .env on a VPS). Never commit the filled-in version.
#
# The API validates all of this at boot and refuses to start on a bad
# config — see apps/api/src/core/config/env.validation.ts.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# node | workers. This file is the CONTAINER configuration, so node.
# On Cloudflare none of this file is used: non-secret values live in "vars"
# in apps/api/wrangler.jsonc, the rest are `wrangler secret put`, and the two
# database URLs come from the Hyperdrive bindings rather than from here.
RUNTIME=node

# ── Database ──────────────────────────────────────────────
# Privileged connection. Used by migrations, the seed, and the platform
# (superadmin) plane, which must operate across tenants and so bypasses RLS.
DATABASE_URL=postgres://dentalcare:CHANGE_ME@db.internal:5432/dentalcare

# Tenant plane. MUST be the non-superuser app_user role created by migration
# the baseline migration. This is the single most important variable in the
# file: if it is
# missing the API refuses to boot, and if it points at a privileged role the
# API refuses to boot, because either would silently disable Row-Level
# Security and expose every clinic's data to every other clinic.
APP_DATABASE_URL=postgres://app_user:CHANGE_ME@db.internal:5432/dentalcare

# Password for the app_user role, read by the baseline migration, which
# converges the role to it rather than only creating it once.
# Avoid single quotes — the migration interpolates this into SQL.
APP_DB_USER=app_user
APP_DB_PASSWORD=CHANGE_ME

# ── Auth ──────────────────────────────────────────────────
# TWO secrets, and they must differ. A clinic token authorises one clinic;
# a platform token authorises every clinic in the deployment. Sharing one
# key means a leak of the secret held by the process serving clinic
# traffic is also a leak of the cross-tenant one.
#
# Both: at least 32 characters, not the development placeholder. Boot is
# refused otherwise, and refused again if the two are equal.
# Generate each with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
PLATFORM_JWT_SECRET=CHANGE_ME_GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_TTL=15m
# Absolute lifetime of a sign-in; refresh rotates the token, never extends it.
JWT_REFRESH_TTL=7d

# ── Two-step sign-in ──────────────────────────────────────
# Must be "required" — boot is refused otherwise.
MFA_ENFORCEMENT=required
# Seals TOTP secrets. REQUIRED. "k1:<base64 of 32 random bytes>"; to rotate,
# put a new key first ("k2:...,k1:...") and keep the old one until every
# factor has been re-sealed or re-enrolled. Losing every key means every
# enrolled user needs a two-step reset.
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEYS=CHANGE_ME

# ── HTTP ──────────────────────────────────────────────────
# Origins allowed to call the API cross-origin, comma separated. Only needed
# when the SPAs are not same-origin with the API (i.e. not proxied through
# Vercel rewrites). A '*' matches one subdomain label.
CORS_ORIGINS=https://admin.dentalcare.com,https://*.dentalcare.com

# ── Reminders ─────────────────────────────────────────────
# How often the in-process scheduler scans for due automatic reminders.
# Ignored when RUNTIME=workers — the Cron Trigger sets the cadence there.
REMINDER_SCAN_INTERVAL_MS=60000
REMINDER_SCAN_BUDGET_MS=45000

# SMS. "log" sends nothing. For "twilio", set the SID, the auth token (a
# secret) and TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID. PUBLIC_API_URL is
# required in production with twilio: delivery receipts are sent there.
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
PUBLIC_API_URL=https://api.dentalcare.com

# WhatsApp Business (none | twilio): the Twilio account above, an approved
# WhatsApp sender, and an approved Content template per language with the
# variables first name, date, time, dentist, clinic — "en:HX…,sq:HX…".
WHATSAPP_PROVIDER=none
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SIDS=

# Viber Business Messages (none | vonage). VONAGE_API_SECRET is a secret.
VIBER_PROVIDER=none
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_VIBER_SENDER=

# ── Albanian fiscalization ────────────────────────────────
# The software code DPT issued for this software. Empty = unavailable.
# Clinic certificates are sealed with MFA_ENCRYPTION_KEYS: rotating those keys
# needs every clinic's certificate re-installed or re-sealed, like MFA factors.
FISCAL_SOFTWARE_CODE=

# Exchange rates for the second currency on estimates. {base} is the quoted
# currency. Defaults to ExchangeRate-API's open endpoint; clinics can use a
# fixed rate instead.
# FX_RATES_URL=https://open.er-api.com/v6/latest/{base}

# ─────────────────────────────────────────────────────────────
# Deliberately NOT set in production:
#
#   ALLOW_TENANT_HEADER   Lets a client pick its clinic via a request header.
#                         Ignored outright when NODE_ENV=production; listing
#                         it here would only be misleading.
#   DEV_TENANT_SUBDOMAIN  Local-only fallback for hosts with no subdomain.
# ─────────────────────────────────────────────────────────────

# ── Object storage for patient documents ────────────────────────────────
# REQUIRED for X-ray and document upload. The bucket must be PRIVATE with
# public access fully blocked — patient radiographs are medical data.
# Enable server-side encryption and a lifecycle/backup policy on the bucket.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=auto
S3_FORCE_PATH_STYLE=1
S3_SIGNED_URL_TTL=300
MAX_UPLOAD_BYTES=41943040

# ── Google sign-in (optional) ─────────────────────────────
# All three or none — the API refuses to boot on a partial set, because a
# half-configured provider means a "Continue with Google" button that lands
# on a Google error page.
#
# The callback must match a redirect URI registered on the Google client
# EXACTLY. Clinics live on wildcard subdomains and a wildcard cannot be
# registered, so there is one callback on the API host for every clinic and
# for the console; the clinic is carried in a signed `state` parameter.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Where the browser is sent after the callback. The clinic host is built by
# prefixing the subdomain onto APP_BASE_URL, because the callback arrives on
# the API host and cannot read the clinic from the request.
APP_BASE_URL=http://localhost:5173
ADMIN_BASE_URL=http://localhost:5174
