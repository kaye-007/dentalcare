# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Which host the API is running on: node | workers.
# Leave it as node locally. `wrangler dev` and the deployed Worker set
# workers themselves through apps/api/wrangler.jsonc, which switches the
# database layer to per-request connections and hands the reminder sweep
# to the Cron Trigger.
RUNTIME=node

# Host ports for `docker compose up`. Change these if something else on your
# machine already owns 3000 or 5432 — the containers are unaffected.
API_PORT=3000
POSTGRES_PORT=5432

# ── CORS ──────────────────────────────────────────────────
# Origins allowed to call the API cross-origin, comma separated; a "*"
# matches exactly one subdomain label. localhost is always allowed, so this
# can stay empty for local work. It is listed here because it IS part of the
# schema and only appeared in .env.production.example, which made it easy to
# miss when copying this file.
CORS_ORIGINS=

# ── Postgres provisioning (docker-compose) ────────────────
POSTGRES_USER=dentalcare
POSTGRES_PASSWORD=dentalcare
POSTGRES_DB=dentalcare

# ── Host vs container database configuration ──────────────
#
# The two connection strings below are the HOST values. They are what a
# process on your own machine uses: npm run api:dev, dev-setup, doctor,
# migrate:up, the integration tests.
#
# The containers do NOT read them. docker-compose.yml builds its own
# strings from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB against the
# host name "postgres", because on compose's network that is where the
# database is and the published port below does not exist. Nothing rewrites
# a URL at runtime — each side is written out where it is used, so changing
# one never silently changes the other.
#
# Change POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB and you must change
# both URLs to match; they are the same credentials seen from two places.

# ── Admin connection (migrations + seed; privileged) ──────
DATABASE_URL=postgres://dentalcare:dentalcare@localhost:5432/dentalcare

# ── Application DB role (M3) — non-superuser, RLS enforced ─
# Created by the baseline migration. APP_DATABASE_URL must match these
# credentials — the role is converged to this password on every migrate.
APP_DB_USER=app_user
APP_DB_PASSWORD=app_user_dev_pw
APP_DATABASE_URL=postgres://app_user:app_user_dev_pw@localhost:5432/dentalcare

# ── Integration tests' own database ───────────────────────
# `npm run test:integration` writes to the database it runs against, so it
# never uses the two URLs above: it refuses to start unless these name a
# database of its own (create it once and run the migrations against it).
# TEST_DATABASE_URL=postgres://dentalcare:dentalcare@localhost:5432/dentalcare_test
# TEST_APP_DATABASE_URL=postgres://app_user:app_user_dev_pw@localhost:5432/dentalcare_test

# ── First platform administrator (docker compose, optional) 
# Set both and the FIRST `docker compose up` also creates the console
# account, so a clean machine goes from git clone to a usable console in one
# command. Leave them empty and the step is skipped — create the account
# later with `npm run admin:create`.
#
# Never overwritten once the account exists, and never printed back. Minimum
# 12 characters, and the passwords published in this repository are refused.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=

# ── Local dev tenant (M3) ─────────────────────────────────
# Which clinic localhost resolves to when there is no real subdomain.
#
# Deliberately empty. This used to ship as "demo", which named a clinic
# nothing in ordinary setup creates — migrations are schema only and the
# demo seed is opt-in — so every login on localhost 404d in
# TenantMiddleware before a password was ever compared, and read as a
# broken login rather than a missing clinic.
#
# `npm run dev:setup` fills this in when it creates your first clinic.
# The API also warns at boot if it names a clinic that does not exist.
DEV_TENANT_SUBDOMAIN=

# ── Demo data (scripts only; the API never reads this) ─────
# `npm run demo:reset` wipes EVERY clinic in DATABASE_URL and loads the one
# fictional demo clinic (docs/DEMO_ACCOUNTS.md). It refuses to run unless
# DEMO_ENV=true — set it for the one command, or uncomment it here only on a
# machine whose database exists for demos. Never set it in production.
# DEMO_ENV=true
# Allows the X-Tenant-Subdomain header to select the clinic. Needed on
# localhost, where there is no subdomain to read. Ignored when
# NODE_ENV=production — never set this in a deployed environment.
ALLOW_TENANT_HEADER=1

# ── Auth ──────────────────────────────────────────────────
# Signs clinic tokens.
JWT_SECRET=dev-only-change-me-please-32chars-min

# Signs platform console tokens. Separate from JWT_SECRET because a
# platform token is authority over every clinic in the deployment, so one
# shared key makes a leak from the clinic plane a leak of that too.
#
# Optional here: left empty, the console falls back to JWT_SECRET so local
# development needs no second secret. Production REQUIRES it, requires 32+
# characters, and refuses a value equal to JWT_SECRET.
PLATFORM_JWT_SECRET=

JWT_ACCESS_TTL=15m
# Absolute lifetime of a sign-in. Refreshing rotates the token but never
# extends this; after it, everyone signs in again.
JWT_REFRESH_TTL=7d

# ── Two-step sign-in (MFA) ────────────────────────────────
# required: administrators and every console account must enrol, and a clinic
# may extend it to all staff. optional: nobody is forced (anyone enrolled is
# still challenged). Production refuses "optional"; the integration suite sets
# it for the suites that are not about MFA.
MFA_ENFORCEMENT=optional
# Keys that seal TOTP secrets at rest: "k2:<base64>,k1:<base64>", 32 bytes
# each; the first seals, all of them open, so rotation is adding a key at the
# front. Empty in development derives one from JWT_SECRET. REQUIRED in
# production. Generate one with:
#   node -e "console.log('k1:' + require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEYS=

# Keys that seal each clinic's WhatsApp Cloud API access token. Same format as
# MFA_ENCRYPTION_KEYS but separate keys. Empty in development derives one from
# JWT_SECRET. REQUIRED in production.
WHATSAPP_ENCRYPTION_KEYS=

# Reminder scheduler — how often the API scans for due automatic reminders (ms)
REMINDER_SCAN_INTERVAL_MS=60000
# How long one pass may run before it stops and leaves the remaining clinics
# first in line for the next (ms).
REMINDER_SCAN_BUDGET_MS=45000

# ── Reminder delivery (optional) ──────────────────────────
# log: reminders are recorded in the reminder log for staff to act on, and
# nothing is sent. twilio: SMS. With twilio, the account SID, auth token and a
# sender (TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID) are required — a partial
# set is refused at boot.
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# The API's public origin, with no path. Delivery receipts are sent here and
# their signatures are checked against it. Without it SMS still sends, but the
# log can only say a message was accepted, never that it arrived.
PUBLIC_API_URL=

# WhatsApp Business reminders, through the same Twilio account (none | twilio).
# Needs an approved WhatsApp sender and approved Content templates, one per
# kind of message and language: sq:HX… (appointment reminder: first name,
# date, time, dentist, clinic), followup.sq:HX… (first name, clinic, visit
# date, clinic phone), balance.sq:HX… (first name, balance, clinic, clinic
# phone). A kind without a template is not offered over WhatsApp.
WHATSAPP_PROVIDER=none
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SIDS=

# Viber Business Messages through the Vonage Messages API (none | vonage).
# VONAGE_API_SECRET is a secret. The sender is the Viber service id Vonage
# issued. No delivery receipts yet: a Viber reminder shows as sent, not delivered.
VIBER_PROVIDER=none
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_VIBER_SENDER=

# ── Albanian fiscalization (optional) ─────────────────────
# The software code the tax authority issued to the maker of this software.
# Without it the Fiscalization settings say it is unavailable. The CIS and
# verification URLs default to the published ones — override only to point at
# a stand-in, and confirm the defaults against DPT's current documentation.
FISCAL_SOFTWARE_CODE=

# Exchange rates for the second currency on estimates. {base} is the quoted
# currency. Defaults to ExchangeRate-API's open endpoint; clinics can use a
# fixed rate instead.
# FX_RATES_URL=https://open.er-api.com/v6/latest/{base}
# FISCAL_CIS_URL_TEST=https://efiskalizimi-test.tatime.gov.al/FiscalizationService
# FISCAL_CIS_URL_PRODUCTION=https://efiskalizimi.tatime.gov.al/FiscalizationService

# ── Object storage for patient documents (X-rays, consent forms) ────────
# S3-compatible. Cloudflare R2 is the cheapest fit (no egress fees); AWS S3,
# DigitalOcean Spaces and MinIO all work unchanged.
#
# The bucket MUST be private. Downloads are served as short-lived pre-signed
# URLs; nothing is ever public-read.
#
# Leave these unset to keep files on the API server's own disk instead — no
# bucket, no storage bill. They go in STORAGE_DIR (the Docker setup mounts a
# named volume there; back it up with the database). Links to them are signed
# and expire just like S3 ones. This needs a server with a disk: on
# Cloudflare Workers, which has none, set a bucket or uploads stay off.
#
# STORAGE_DRIVER=        # s3 | local | off — unset picks s3 if configured, else local
# STORAGE_DIR=storage    # relative to the API's working directory
# STORAGE_SIGNING_SECRET= # optional, 32+ chars; derived from JWT_SECRET if unset
# Blank = disabled. Set all three (bucket + both keys) to turn document
# upload on; a partial set is rejected at boot rather than silently
# dropping uploads at runtime.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Omit for AWS S3. For R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# 'auto' for R2; a real region for AWS/Spaces.
S3_REGION=auto
# '1' for R2 and MinIO, which address buckets by path rather than by host.
S3_FORCE_PATH_STYLE=1
# Seconds a download link stays valid. 30-3600.
S3_SIGNED_URL_TTL=300
# Largest single upload in bytes. Default 40MB — a panoramic X-ray fits well
# under this; DICOM studies can be larger, so raise it if your sensor needs it.
MAX_UPLOAD_BYTES=41943040

# ── Google sign-in (optional) ─────────────────────────────
# All three or none — the API refuses to boot on a partial set, because a
# half-configured provider means a "Continue with Google" button that lands
# on a Google error page.
#
# The callback must match a redirect URI registered on the Google client
# EXACTLY. Clinics live on wildcard subdomains and a wildcard cannot be
# registered, so there is one callback on the API host for every clinic and
# for the console; the clinic is carried in a signed `state` parameter.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# All three must be set together, or all three left unset — a partial set is
# refused at boot. Uncomment this line only when you fill in the two above.
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Where the browser is sent after the callback. The clinic host is built by
# prefixing the subdomain onto APP_BASE_URL, because the callback arrives on
# the API host and cannot read the clinic from the request.
APP_BASE_URL=http://localhost:5173
ADMIN_BASE_URL=http://localhost:5174
