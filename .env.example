# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Which host the API is running on: node | workers.
# Leave it as node locally. `wrangler dev` and the deployed Worker set
# workers themselves through apps/api/wrangler.jsonc, which switches the
# database layer to per-request connections and hands the reminder sweep
# to the Cron Trigger.
RUNTIME=node

# Host ports for `docker compose up`. Change these if something else on your
# machine already owns 3000 or 5432 — the containers are unaffected.
API_PORT=3000
POSTGRES_PORT=5432

# ── CORS ──────────────────────────────────────────────────
# Origins allowed to call the API cross-origin, comma separated; a "*"
# matches exactly one subdomain label. localhost is always allowed, so this
# can stay empty for local work. It is listed here because it IS part of the
# schema and only appeared in .env.production.example, which made it easy to
# miss when copying this file.
CORS_ORIGINS=

# ── Postgres provisioning (docker-compose) ────────────────
POSTGRES_USER=dentalcare
POSTGRES_PASSWORD=dentalcare
POSTGRES_DB=dentalcare

# ── Host vs container database configuration ──────────────
#
# The two connection strings below are the HOST values. They are what a
# process on your own machine uses: npm run api:dev, dev-setup, doctor,
# migrate:up, the integration tests.
#
# The containers do NOT read them. docker-compose.yml builds its own
# strings from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB against the
# host name "postgres", because on compose's network that is where the
# database is and the published port below does not exist. Nothing rewrites
# a URL at runtime — each side is written out where it is used, so changing
# one never silently changes the other.
#
# Change POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB and you must change
# both URLs to match; they are the same credentials seen from two places.

# ── Admin connection (migrations + seed; privileged) ──────
DATABASE_URL=postgres://dentalcare:dentalcare@localhost:5432/dentalcare

# ── Application DB role (M3) — non-superuser, RLS enforced ─
# Created by migration 0003. APP_DATABASE_URL must match these credentials.
APP_DB_USER=app_user
APP_DB_PASSWORD=app_user_dev_pw
APP_DATABASE_URL=postgres://app_user:app_user_dev_pw@localhost:5432/dentalcare

# ── First platform administrator (docker compose, optional) 
# Set both and the FIRST `docker compose up` also creates the console
# account, so a clean machine goes from git clone to a usable console in one
# command. Leave them empty and the step is skipped — create the account
# later with `npm run admin:create`.
#
# Never overwritten once the account exists, and never printed back. Minimum
# 12 characters, and the passwords published in this repository are refused.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_NAME=

# ── Local dev tenant (M3) ─────────────────────────────────
# Which clinic localhost resolves to when there is no real subdomain.
DEV_TENANT_SUBDOMAIN=demo
# Allows the X-Tenant-Subdomain header to select the clinic. Needed on
# localhost, where there is no subdomain to read. Ignored when
# NODE_ENV=production — never set this in a deployed environment.
ALLOW_TENANT_HEADER=1

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=dev-only-change-me-please-32chars-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Reminder scheduler — how often the API scans for due automatic reminders (ms)
REMINDER_SCAN_INTERVAL_MS=60000

# ── Object storage for patient documents (X-rays, consent forms) ────────
# S3-compatible. Cloudflare R2 is the cheapest fit (no egress fees); AWS S3,
# DigitalOcean Spaces and MinIO all work unchanged.
#
# The bucket MUST be private. Downloads are served as short-lived pre-signed
# URLs; nothing is ever public-read.
#
# Leave these unset to run without document upload — every other feature
# works, and the API says so clearly if someone tries to upload.
# Blank = disabled. Set all three (bucket + both keys) to turn document
# upload on; a partial set is rejected at boot rather than silently
# dropping uploads at runtime.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Omit for AWS S3. For R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
# 'auto' for R2; a real region for AWS/Spaces.
S3_REGION=auto
# '1' for R2 and MinIO, which address buckets by path rather than by host.
S3_FORCE_PATH_STYLE=1
# Seconds a download link stays valid. 30-3600.
S3_SIGNED_URL_TTL=300
# Largest single upload in bytes. Default 40MB — a panoramic X-ray fits well
# under this; DICOM studies can be larger, so raise it if your sensor needs it.
MAX_UPLOAD_BYTES=41943040

# ── Google sign-in (optional) ─────────────────────────────
# All three or none — the API refuses to boot on a partial set, because a
# half-configured provider means a "Continue with Google" button that lands
# on a Google error page.
#
# The callback must match a redirect URI registered on the Google client
# EXACTLY. Clinics live on wildcard subdomains and a wildcard cannot be
# registered, so there is one callback on the API host for every clinic and
# for the console; the clinic is carried in a signed `state` parameter.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# All three must be set together, or all three left unset — a partial set is
# refused at boot. Uncomment this line only when you fill in the two above.
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Where the browser is sent after the callback. The clinic host is built by
# prefixing the subdomain onto APP_BASE_URL, because the callback arrives on
# the API host and cannot read the clinic from the request.
APP_BASE_URL=http://localhost:5173
ADMIN_BASE_URL=http://localhost:5174
