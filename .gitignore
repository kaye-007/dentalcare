# ── dependencies ──────────────────────────────────────────
node_modules/

# ── build output ──────────────────────────────────────────
dist/
build/
coverage/
*.tsbuildinfo

# ── tool caches ───────────────────────────────────────────
.wrangler/
.worker-build/
node_modules/.vite/
node_modules/.tmp/
.vite/

# Cursor writes a semantic index into .git/ — never commit it
.git/cursor/
.cursor/

# ── assistant / analysis scratch ──────────────────────────
# Regenerable output that kept reappearing at the repo root. None of it is
# input to a build: the graph is rebuilt by /graphify, the rest were one-off
# snapshots that git already holds the source for.
graphify-out/
_audit_tmp/
Claude outputs/

# ── secrets ───────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── logs & OS / editor noise ──────────────────────────────
*.log
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# ── cleanup quarantine (safe to delete) ───────────────────
_to_delete/

# local build-rig transfer archive
.sync/

# Build output of the shared package — regenerated by `npm run shared:build`.
packages/shared/dist

# Uploaded files kept on local disk (STORAGE_DIR)
apps/api/storage/
/storage/

# Database backups (scripts/db-backup.js): every clinic's records. Never commit.
backups/

# Written by scripts/build-baseline.js when a verify fails.
.baseline-diff/
