{
  "name": "@dentalcare/api",
  "version": "0.1.0",
  "private": true,
  "description": "DentalCare API — modular monolith (NestJS)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate:up": "node-pg-migrate up -m migrations --envPath ../../.env",
    "migrate:down": "node-pg-migrate down -m migrations --envPath ../../.env",
    "migrate:create": "node-pg-migrate create -m migrations",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/throttler": "^6.5.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.1.0",
    "pg": "^8.13.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.16.10",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.7.0",
    "pino-pretty": "^11.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
