{
  "name": "@dentalcare/api",
  "version": "0.1.0",
  "private": true,
  "description": "DentalCare API \u2014 modular monolith (NestJS)",
  "scripts": {
    "build": "nest build",
    "build:worker": "nest build && node scripts/build-worker.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "npm run build:worker && tsc -p tsconfig.worker.json",
    "cf:dev": "npm run build:worker && wrangler dev",
    "cf:deploy": "npm run build:worker && wrangler deploy",
    "cf:dry-run": "npm run build:worker && wrangler deploy --dry-run --outdir=.wrangler/dry-run",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "migrate:up": "node-pg-migrate up -m migrations --envPath ../../.env",
    "migrate:down": "node-pg-migrate down -m migrations --envPath ../../.env",
    "migrate:reset": "node scripts/migrate-reset.js",
    "migrate:create": "node-pg-migrate create -m migrations",
    "seed": "node scripts/seed-demo.js",
    "reset-demo": "node scripts/reset-demo.js",
    "bootstrap-admin": "node scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/throttler": "^6.5.0",
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.16.3",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260827.1",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.10",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.7.0",
    "pino-pretty": "^11.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.6.2",
    "wrangler": "^4.127.0"
  }
}
