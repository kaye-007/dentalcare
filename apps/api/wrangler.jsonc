{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dentalcare-api",

  // Two-stage build; scripts/build-worker.mjs explains why. tsc compiles the
  // Nest application (it needs emitDecoratorMetadata, which esbuild cannot
  // emit), esbuild flattens it into .worker-build/app.cjs with node resolution
  // semantics, and wrangler bundles this entry around it.
  "main": "worker/index.ts",

  "minify": true,
  "alias": { "dentalcare-app-bundle": "./.worker-build/app.cjs" },

  // Anything after 2025-08-15 turns on node:http / node:https server support,
  // which is what lets Express — and therefore Nest — run here at all.
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "placement": { "mode": "smart" },

  // ── Database ────────────────────────────────────────────────────────────
  //
  // TWO bindings, deliberately. The tenant plane connects as app_user, which
  // the baseline creates NOSUPERUSER / NOBYPASSRLS, so Row-Level Security is
  // enforced; the platform plane connects with the privileged role and
  // bypasses RLS by design. Pointing both at one Hyperdrive config would mean
  // every clinic reads every other clinic's records.
  //
  // Create both before the first deploy and paste the ids in. --caching-
  // disabled is not optional here: Hyperdrive's result cache is keyed on the
  // query, not on the transaction that set app.current_tenant_id, so a cached
  // row from one clinic could be served to another. Caching lives on the
  // config, not on the binding, which is why it is a flag and not a field.
  //
  //   wrangler hyperdrive create dentalcare-app --caching-disabled \
  //     --connection-string="postgres://app_user:PASSWORD@db.PROJECT.supabase.co:5432/postgres"
  //
  //   wrangler hyperdrive create dentalcare-admin --caching-disabled \
  //     --connection-string="postgres://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres"
  //
  // Use Supabase's DIRECT host on port 5432, not the 6543 pooler. Hyperdrive
  // is the pooler, and Supabase's transaction-mode pooler does not hold the
  // session state that set_config('app.current_tenant_id', ..., true) needs.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_APP",
      "id": "REPLACE_WITH_HYPERDRIVE_APP_ID",
      "localConnectionString": "postgres://app_user:app_user_dev_pw@127.0.0.1:5432/dentalcare",
    },
    {
      "binding": "HYPERDRIVE_ADMIN",
      "id": "REPLACE_WITH_HYPERDRIVE_ADMIN_ID",
      "localConnectionString": "postgres://dentalcare:dentalcare@127.0.0.1:5432/dentalcare",
    },
  ],

  // ── Background work ─────────────────────────────────────────────────────
  //
  // Automatic appointment reminders, every 15 minutes. This replaces the
  // in-process setInterval in ReminderSchedulerService, which a Worker cannot
  // run: there is no resident process between requests to hold a timer.
  //
  // Hourly was too coarse once reminders actually send: a retry the provider
  // asked for in 5 minutes waited up to an hour, and a "2 hours before"
  // reminder could leave with an hour to go. Each pass stops after
  // REMINDER_SCAN_BUDGET_MS (45s by default) and leaves the remaining clinics
  // first in line for the next.
  "triggers": { "crons": ["*/15 * * * *"] },

  // The SPAs reach the API through a service binding on their own origin, so
  // this public hostname exists for one thing: GOOGLE_CALLBACK_URL, which
  // Google requires to be a single fixed URI.
  "routes": [{ "pattern": "api.dentalcare.com", "custom_domain": true }],

  // Non-secret configuration only. JWT_SECRET, PLATFORM_JWT_SECRET,
  // MFA_ENCRYPTION_KEYS, GOOGLE_CLIENT_SECRET, the S3 credentials and
  // TWILIO_AUTH_TOKEN are secrets:  wrangler secret put TWILIO_AUTH_TOKEN
  //
  // SMS stays off ("log") until an account is ready. To turn it on, set
  // SMS_PROVIDER to "twilio", add TWILIO_ACCOUNT_SID and TWILIO_FROM (or
  // TWILIO_MESSAGING_SERVICE_SID) here, and put the auth token as a secret.
  // The API refuses to boot with a partial set.
  "vars": {
    "NODE_ENV": "production",
    "RUNTIME": "workers",
    "CORS_ORIGINS": "https://*.dentalcare.com,https://admin.dentalcare.com",
    "APP_BASE_URL": "https://dentalcare.com",
    "ADMIN_BASE_URL": "https://admin.dentalcare.com",
    // Where SMS delivery receipts are sent; their signatures are checked
    // against this origin, so it must be exactly what the provider calls.
    "PUBLIC_API_URL": "https://api.dentalcare.com",
    "SMS_PROVIDER": "log",
    // WhatsApp and Viber stay off until their accounts and templates are
    // approved. VONAGE_API_SECRET is a secret; the rest belong here.
    "WHATSAPP_PROVIDER": "none",
    "VIBER_PROVIDER": "none",
    "S3_REGION": "auto",
    "S3_FORCE_PATH_STYLE": "1",
  },
}
