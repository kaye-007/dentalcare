{
  // Typecheck only — the Worker entry is compiled by wrangler's bundler, not
  // by tsc. It imports the tsc-emitted ../dist, so run `nest build` first.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node", "@cloudflare/workers-types"]
  },
  "include": ["worker/**/*.ts"],
  "exclude": ["node_modules"]
}
